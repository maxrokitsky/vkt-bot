    "inlineKeyboardMarkup": {
        "name": "inlineKeyboardMarkup",
        "in": "body",
        "description": "tr{{mainPage.inlineKeyboardMarkupDesc}}",
        "schema": {
            "type": "array",
            "items": {
                "type": "array",
                "items": {
                    "oneOf": [
                        {
                            "type": "object",
                            "properties": {
                                "text": {
                                    "type": "string",
                                    "description": "tr{{mainPage.textOnButton}}",
                                    "example": "🌎 Visit website"
                                },
                                "url": {
                                    "type": "string",
                                    "description": "tr{{mainPage.buttonClickUrl}}",
                                    "example": "http://teams.vk.com"
                                },
                                "style": {
                                    "type": "string",
                                    "description": "tr{{mainPage.buttonsTextStyle}}",
                                    "enum": [
                                        "attention",
                                        "primary",
                                        "base"
                                    ],
                                    "example": "attention",
                                    "default": "base"
                                }
                            },
                            "required" : [ "text", "url" ]
                        },
                        {
                            "type": "object",
                            "properties": {
                                "text": {
                                    "type": "string",
                                    "description": "tr{{mainPage.textOnButton}}",
                                    "example": "🤖 Make a query"
                                },
                                "callbackData": {
                                    "type": "string",
                                    "description": "tr{{mainPage.botCallbackData}}",
                                    "example": "RXhhbXBsZSBjYWxsYmFjayBkYXRhCg=="
                                },
                               "style": {
                                    "type": "string",
                                    "description": "tr{{mainPage.buttonsTextStyle}}",
                                    "enum": [
                                        "attention",
                                        "primary",
                                        "base"
                                    ],
                                    "example": "primary",
                                    "default": "base"
                                }
                            },
                            "required" : [ "text", "callbackData" ]
                        }
                    ]
                }
            }
        }
    },
    "formatCommonParams": {
	"type": "object",
	"properties": {
	    "offset": {
		"type": "integer",
                "description": "tr{{mainPage.formatOffsetDesc}}",
                "example": 0
	    },
	    "length": {
		"type": "integer",
                "description": "tr{{mainPage.formatLengthDesc}}",
                "example": 1
	    }
	},
	"required": [
	    "offset",
	    "length"
	]
    },
    "formatSchema": {
        "type": "object",
        "properties": {
            "bold": {
                "type": "array",
                "description": "tr{{mainPage.formatBold}}",
                "items": {
                    "$ref": "#formatCommonParams"
                }
            },
            "italic": {
                "type": "array",
                "description": "tr{{mainPage.formatItalic}}",
                "items": {
                    "$ref": "#formatCommonParams"
                }
            },
            "underline": {
                "type": "array",
                "description": "tr{{mainPage.formatUnderline}}",
                "items": {
                    "$ref": "#formatCommonParams"
                }
            },
            "strikethrough": {
                "type": "array",
                "description": "tr{{mainPage.formatStrikethrough}}",
                "items": {
                    "$ref": "#formatCommonParams"
                }
            },
            "link": {
                "type": "array",
                "description": "tr{{mainPage.formatLink}}",
                "items": {
                    "allOf": [
                        {
                            "$ref": "#formatCommonParams"
                        },
                        {
                            "type": "object",
                            "properties": {
                                "url": {
                                    "type": "string",
                                    "example": "https://example.com/"
                                }
                            },
                            "required": "url"
                        }
                    ]
                }
            },
            "mention": {
                "type": "array",
                "description": "tr{{mainPage.formatMention}}",
                "items": {
                    "$ref": "#formatCommonParams"
                }
            },
            "inline_code": {
                "type": "array",
                "description": "tr{{mainPage.formatInlineCode}}",
                "items": {
                    "$ref": "#formatCommonParams"
                }
            },
            "pre": {
                "type": "array",
                "description": "tr{{mainPage.formatPre}}",
                "items": {
                    "allOf": [
                        {
                            "$ref": "#formatCommonParams"
                        },
                        {
                            "type": "object",
                            "properties": {
                                "code": {
                                    "type": "string"
                                }
                            }
                        }
                    ]
                }
            },
            "ordered_list": {
                "type": "array",
                "description": "tr{{mainPage.formatOrderedList}}",
                "items": {
                    "$ref": "#formatCommonParams"
                }
            },
            "unordered_list": {
                "type": "array",
                "description": "tr{{mainPage.formatUnorderedList}}",
                "items": {
                    "$ref": "#formatCommonParams"
                }
            },
            "quote": {
                "type": "array",
                "description": "tr{{mainPage.formatQuote}}",
                "items": {
                    "$ref": "#formatCommonParams"
                }
            }
        }
    },
    "format": {
        "name": "format",
        "in": "body",
        "description": "tr{{mainPage.formatDesc}}",
        "schema": {
            "$ref": "#formatSchema"
        }
    },
    "parseMode": {
        "name": "parseMode",
        "in": "query",
        "description": "tr{{mainPage.parseModeDesc}}",
        "schema": {
            "type": "string",
