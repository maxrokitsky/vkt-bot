    "withExisting": {
        "name": "withExisting",
        "in": "query",
        "schema": {
            "type": "boolean"
        },
        "description": "tr{{mainPage.withExistingDesc}}",
        "example": true
    },
    "pageSize": {
        "name": "pageSize",
        "in": "query",
        "schema": {
            "type": "integer"
        },
        "description": "tr{{mainPage.pageSizeDesc}}",
        "example": 10
    }
}
